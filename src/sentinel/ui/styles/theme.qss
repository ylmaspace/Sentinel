"""Premium dark Sentinel theme."""
QWidget {
    background-color: #10151c;
    color: #edf2f7;
    font-family: "Segoe UI", Arial;
    font-size: 12px;
}
QMainWindow { background-color: #10151c; }
#Header { background: #172231; color: #ffffff; font-size: 14px; font-weight: 700; padding: 12px; border-bottom: 1px solid #26384d; }
#Footer { color: #98a6b8; background: #0c1117; padding: 8px 12px; border-top: 1px solid #26384d; }
#PageTitle { font-size: 20px; font-weight: 700; color: #ffffff; padding: 6px 0; }
#Muted { color: #98a6b8; }
#EmptyState { color: #98a6b8; padding: 18px; border: 1px dashed #34465a; border-radius: 6px; }
#InfoCard { background: #172231; border: 1px solid #26384d; border-radius: 8px; padding: 12px; }
#CardHeading { color: #98a6b8; font-size: 10px; font-weight: 700; }
#CardValue { color: #f0aa3c; font-size: 24px; font-weight: 700; }
#StatusBadge { background: #26384d; color: #ffffff; border-radius: 10px; padding: 4px 8px; }
#NavButton { text-align: left; padding: 12px 14px; border: none; border-radius: 6px; color: #b7c2cf; background: transparent; }
#NavButton:hover { background: #1b2a3b; color: #ffffff; }
#NavButton:checked { background: #26384d; color: #f0aa3c; border-left: 3px solid #f0aa3c; }
QPushButton { background: #26384d; color: #ffffff; border: 1px solid #365069; border-radius: 6px; padding: 8px 12px; }
QPushButton:hover { background: #304960; }
QPushButton:disabled { color: #718096; background: #18212c; }
QTableWidget { background: #111923; alternate-background-color: #151d28; gridline-color: #26384d; border: 1px solid #26384d; }
QHeaderView::section { background: #1b2a3b; color: #b7c2cf; border: none; padding: 8px; }
QTextEdit, QLineEdit { background: #111923; border: 1px solid #26384d; border-radius: 6px; padding: 8px; selection-background-color: #365069; }
QProgressBar { border: 1px solid #26384d; border-radius: 6px; text-align: center; background: #111923; }
QProgressBar::chunk { background: #f0aa3c; }
